{
  "name": "hazardlens",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "viewer": "vite --config viewer/vite.config.ts --host 0.0.0.0",
    "viewer:build": "tsc -p tsconfig.viewer.json && vite build --config viewer/vite.config.ts",
    "build:all": "npm run build && npm run viewer:build",
    "test:browser": "node scripts/browser-smoke.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
